{
  "manifest_version": 3,
  "name": "QuickDial",
  "version": "1.0.0",
  "description": "Minimalist new tab page with bookmark quick dial",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "bookmarks",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "88"
}
