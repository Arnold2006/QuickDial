{
  "manifest_version": 3,
  "name": "QuickDial",
  "version": "1.0.0",
  "description": "A minimalist new-tab quick-dial page that shows your bookmarks as a tile grid.",
  "permissions": ["bookmarks", "storage"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
